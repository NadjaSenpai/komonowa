{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komonowa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 公開URLはカスタムドメインのみ（workers.dev とプレビューURLは無効）
  "routes": [{ "pattern": "komonowa.nadja.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // 招待・パスワード再設定のメール（Cloudflare Email Sending。Workers Paid と送信元ドメインの登録が必要）
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "MAIL_FROM": "komonowa@nadja.dev" },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wiki-db",
      "database_id": "f9265d93-a786-4e67-a93f-ba91554ae6c5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      // 公開アクセスを有効にしないこと（Worker 経由でのみ配信する）
      "bucket_name": "wiki-files"
    }
  ],
  "observability": { "enabled": true }
}
