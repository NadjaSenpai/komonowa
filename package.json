{
  "name": "team-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply wiki-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wiki-db --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "check": "tsc -b && vitest run && vite build",
    "backup:remote": "node scripts/backup.mjs --remote",
    "backup:local": "node scripts/backup.mjs --local",
    "restore:r2": "node scripts/restore-r2.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "hono": "^4.13.17",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261110.1": true
  },
  "engines": {
    "node": ">=22"
  }
}
